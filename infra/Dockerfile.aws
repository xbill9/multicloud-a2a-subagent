# The AWS agent, packaged for Bedrock AgentCore Runtime.
#
# AgentCore's A2A protocol contract is narrow and every clause below is load
# bearing:
#
#   host      0.0.0.0
#   port      9000        (not 8080, which is the HTTP protocol's port)
#   path      /           (not /invocations, which is the HTTP protocol's path)
#   health    GET /ping -> {"status": "Healthy"}
#   card      GET /.well-known/agent-card.json
#   platform  ARM64       (required, not a preference)
#
# The Starlette app in agents/serving.py already serves JSON-RPC at / and the
# card at the well-known path, so it satisfies the contract unmodified. /ping
# was added for this contract specifically -- the pre-existing /health is not
# what AgentCore polls, and a container that fails the ping never reaches the
# point of being invoked.
FROM --platform=linux/arm64 python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# strands-agents WAS omitted here on the reasoning below. The reasoning was
# sound and the consequence was not: the deployed agent accepted
# RESEARCH_MODEL_MODE=llm and then failed on import, so the one mode this image
# could not serve was also the one it advertised no objection to. It is a pure
# -Python package; installing it unconditionally costs image size and removes a
# configuration that could never work.
#
# Superseded reasoning, kept because it explains the original shape:
# strands-agents is omitted: it is needed only for `llm` mode, and the matrix
# runs `direct` so a red cell is unambiguously a protocol failure rather than a
# throttled Bedrock call. See "keep the two axes separate" in
# docs/DEPLOYMENT_PLAN.md.
RUN pip install \
      "a2a-sdk[http-server]" \
      strands-agents \
      pydantic \
      httpx \
      uvicorn \
      opentelemetry-sdk \
      opentelemetry-instrumentation-httpx \
      opentelemetry-instrumentation-logging \
      opentelemetry-instrumentation-starlette \
      opentelemetry-exporter-otlp-proto-http

# A researcher, and only a researcher. It answers a brief with this cloud's own
# model and returns markdown over A2A; it does not call anyone, judge anything,
# or mint a credential for a third cloud.
#
# `coordinator` and `clients` were copied here until 2026-08-13, which put the
# judge, the master service, the front end and the three-cloud credential
# adapter on this vendor's infrastructure. `clients` was never imported at all.
# `coordinator` was, by a single line -- agents/common.py took `ResearchRequest`
# from `coordinator.models` -- and one import is all it takes: the whole package
# has to be present for the container to start. The two types that cross the
# wire live in `protocol` now, so this image carries the agent and the protocol
# and nothing else.
COPY pyproject.toml README.md ./
COPY agents ./agents
COPY protocol ./protocol

RUN pip install --no-deps -e .

# PUBLIC_URL is set at deploy time, once the runtime ARN exists, because the
# card must advertise the AgentCore invocations URL rather than this
# container's bind address. Without it the card advertises 0.0.0.0:9000 --
# interop finding 2, the defect that breaks ADK's own client against a hosted
# server and that only reproduces once bind and dial addresses differ.
ENV HOST=0.0.0.0 \
    PORT=9000 \
    RESEARCH_MODEL_MODE=direct

EXPOSE 9000
CMD ["python", "-m", "agents.aws.server"]
