# FALLBACK, not the default path. GCP now deploys from source -- see Procfile
# and infra/deploy_gcp.sh -- and this file exists for the day the buildpack
# cannot express something. It is deliberately NOT at the repo root: `gcloud
# run deploy --source` prefers a root Dockerfile when it finds one, so leaving
# it there turned every containerless deploy back into a container build of the
# GCP researcher, whatever was being deployed.
#
# To use it:  gcloud builds submit --config=- ...  or docker build -f this .
# with the repo root as the build context.
#
# One image, several entrypoints: the researcher runs as a Cloud Run service,
# the master as another, the coordinator and matrix as jobs. Their dependency
# sets overlap almost entirely, and a single image means the deployed
# coordinator is provably the same code as the deployed agent.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Unpinned deliberately, and now unpinned entirely. google-adk 2.4.0 could not
# serve A2A v1.0 (finding 4 in docs/INTEROP.md), but that was a fact about
# 2.4.0, not a law: retested 2026-08-02 against google-adk 2.6.1 + a2a-sdk
# 1.1.2 and to_a2a imports and serves. A pin nobody retests is
# indistinguishable from rot.
#
# The last pin here was `mcp<2`, for a real measured failure: google-adk 2.6.3
# imports names that mcp 2.0 moved (`McpHttpClientFactory`,
# `mcp.shared.session`), and ADK's bare try/except turned that into an empty
# `__all__` rather than an error naming mcp. It is gone because the dependency
# is gone -- the GCP agent's rate lookup is a native ADK function tool now, so
# nothing in this image imports `google.adk.tools.mcp_tool`. The upstream
# defect is untouched; this image simply no longer stands on it.
RUN pip install \
      "a2a-sdk[http-server]" \
      google-adk \
      agent-framework-a2a \
      agent-framework-core \
      pydantic \
      httpx \
      uvicorn

COPY pyproject.toml README.md ./
COPY agents ./agents
COPY clients ./clients
COPY coordinator ./coordinator
COPY matrix ./matrix
COPY protocol ./protocol
COPY evaluations ./evaluations

RUN pip install --no-deps -e .

# Cloud Run routes to $PORT and requires a non-loopback bind. The agent
# defaults HOST to 127.0.0.1 for local runs, so it must be set here --
# a container listening on loopback fails Cloud Run's health check with a
# message that says nothing about the bind address.
ENV HOST=0.0.0.0 \
    PORT=8080 \
    RESEARCH_MODEL_MODE=direct

CMD ["python", "-m", "agents.gcp.server"]
